# ---------------------------------------------------------------------------
# Crypto Portfolio - configuration
# Copy this file to ".env" and fill in the values. Never share or commit .env.
# ---------------------------------------------------------------------------

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: your server ID. When set, slash commands are registered to that server only (they
# appear instantly). When empty, they are registered globally (also usable in DMs; can take a while).
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs that may use the bot. Everyone else is refused.
OWNER_IDS=

# Free Etherscan API key(s), https://etherscan.io/apidashboard (the free plan covers Ethereum and
# Polygon). Several keys can be separated by commas; requests rotate between them.
ETHERSCAN_API_KEY=

# IANA time zone for the daily summary and reports, e.g. Europe/Berlin, America/New_York, UTC
TIMEZONE=UTC

# Text file with your wallets (one "Name = address" per line). Created with instructions on first
# start; saved changes are picked up automatically.
WALLETS_FILE=./wallets.txt

# Where the SQLite database is stored
DATABASE_PATH=./data/portfolio.db

# Stop a history import after this many transactions per wallet and network (protects the free
# APIs from accidental huge imports, e.g. an exchange wallet).
MAX_HISTORY_TRANSACTIONS=50000

# Optional: HTTP(S) proxies for blockchain and price requests only (Discord never uses them).
# Mainly for reliability. Respect each data provider's terms; do not use proxies to exceed limits.
# Format: http://user:pass@host:port   Several: separate with commas.
PROXY_URLS=
# For a rotating gateway (one URL, new IP per connection): parallel connections to use (1-10).
PROXY_SLOTS=1
# Also use your own connection when proxies are set (true/false).
PROXY_INCLUDE_DIRECT=true

# Scale the built-in request rates (0.1 to 3). Keep 1 unless a provider allows more.
HTTP_RATE_MULTIPLIER=1

# debug | info | warn | error
LOG_LEVEL=info
