{
  "name": "crypto-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Discord bot: crypto wallet tracker with payment notifications and portfolio profit/loss. Address-only, read-only.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ubaidullah71/crypto-tracker.git"
  },
  "homepage": "https://github.com/Ubaidullah71/crypto-tracker#readme",
  "bugs": {
    "url": "https://github.com/Ubaidullah71/crypto-tracker/issues"
  },
  "author": "Ubaidullah71",
  "keywords": [
    "discord",
    "bot",
    "crypto",
    "portfolio",
    "wallet-tracker",
    "bitcoin",
    "ethereum",
    "solana",
    "litecoin",
    "xrp"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "deploy-commands": "node --disable-warning=ExperimentalWarning src/discord/deploy.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run format:check && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-data": "node --disable-warning=ExperimentalWarning scripts/check-data.ts"
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "undici": "8.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
